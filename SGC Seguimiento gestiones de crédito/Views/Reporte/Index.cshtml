@{
    ViewData["Title"] = "Reporte de gestiones";
}

<h1>@ViewData["Title"]</h1>

<div class="row mb-3">
    <div class="col-md-4">
        <label for="txtFiltroUsuario" class="form-label">Filtrar por cliente (usuario)</label>
        <input id="txtFiltroUsuario" class="form-control" placeholder="Escribe nombre de usuario..."/>
    </div>
    <div class="col-md-4">
        <label for="txtSolicitudId" class="form-label">Filtrar por ID de solicitud</label>
        <input id="txtSolicitudId" type="number" class="form-control" placeholder="ID de solicitud"/>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button id="btnBuscar" class="btn btn-primary me-2">Buscar</button>
        <button id="btnLimpiar" class="btn btn-secondary">Limpiar</button>
    </div>
</div>

<table id="tblReporte" class="table table-striped">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Usuario</th>
            <th>Estado Anterior</th>
            <th>Estado Nuevo</th>
            <th>Comentarios</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts {
    <script>
        $(function () {
            var table = $('#tblReporte').DataTable({
                columns: [
                    { data: 'fecha', render: function (d) { return new Date(d).toLocaleString('es-ES'); } },
                    { data: 'usuarioId' },
                    { data: 'estadoAnterior' },
                    { data: 'estadoNuevo' },
                    { data: 'comentarios' }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json'
                }
            });

            // Cargar todos los datos al inicio
            function cargarTodos() {
                $.get('/Reporte/ObtenerTodos')
                    .done(function (resp) {
                        console.log('Datos recibidos:', resp.data);
                        table.clear().rows.add(resp.data).draw();
                    })
                    .fail(function (xhr, status, error) { 
                        console.error('Error al cargar:', error);
                        Swal.fire('Error', 'No se pudo cargar los reportes', 'error'); 
                    });
            }

            // Cargar datos al inicio
            cargarTodos();

            $('#btnBuscar').on('click', function () {
                var usuario = $('#txtFiltroUsuario').val().trim();
                var solicitudId = $('#txtSolicitudId').val().trim();
                
                if (solicitudId) {
                    // Buscar por solicitud
                    $.get('/Reporte/BuscarPorSolicitud', { solicitudId: solicitudId })
                        .done(function (resp) {
                            var datos = resp.data;
                            // Filtrar por usuario si se especificó
                            if (usuario) {
                                datos = datos.filter(function(item) {
                                    return item.usuarioId && item.usuarioId.toLowerCase().indexOf(usuario.toLowerCase()) !== -1;
                                });
                            }
                            table.clear().rows.add(datos).draw();
                        })
                        .fail(function () { Swal.fire('Error', 'No se pudo obtener reporte', 'error'); });
                } else if (usuario) {
                    // Filtrar solo por usuario
                    $.get('/Reporte/ObtenerTodos')
                        .done(function (resp) {
                            var datos = resp.data.filter(function(item) {
                                return item.usuarioId && item.usuarioId.toLowerCase().indexOf(usuario.toLowerCase()) !== -1;
                            });
                            table.clear().rows.add(datos).draw();
                        })
                        .fail(function () { Swal.fire('Error', 'No se pudo obtener reporte', 'error'); });
                } else {
                    // Si no hay filtros, cargar todos
                    cargarTodos();
                }
            });

            $('#btnLimpiar').on('click', function () {
                $('#txtFiltroUsuario').val('');
                $('#txtSolicitudId').val('');
                cargarTodos();
            });
        });
    </script>
}
