@model IEnumerable<ProyectoSGCBLL.Dtos.SolicitudCreditoDto>

@{
    ViewData["Title"] = "Solicitudes de crédito";
}

<h1>@ViewData["Title"]</h1>

<p>
    
    {
        <button id="btnCrear" class="btn btn-primary">Crear solicitud</button>
    }
</p>

<div id="alertPlaceholder"></div>

<!-- Modal host (Bootstrap) -->
<div class="modal fade" id="app-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content"><!-- contenido cargado por AJAX --></div>
    </div>
</div>

<table class="table table-striped" id="solicitudesTable">
    <thead>
        <tr>
            <th>Id</th>
            <th>Identificación</th>
            <th>Monto</th>
            <th>Comentarios</th>
            <th>Documento</th>
            <th style="width:220px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @if (Model != null)
    {
        foreach (var s in Model)
        {
            <tr data-id="@s.Id">
                <td>@s.Id</td>
                <td>@s.Identificacion</td>
                <td>@s.MontoSolicitado</td>
                <td>@s.Comentarios</td>
                <td>@s.Documento</td>
                <td class="text-nowrap">
                    <button class="btn btn-sm btn-outline-secondary js-open-modal"
                            data-url="@Url.Action("EditPartial", "SolicitudCredito", new { id = s.Id })">Editar</button>

                    <button class="btn btn-sm btn-danger js-open-modal ms-1"
                            data-url="@Url.Action("DeletePartial", "SolicitudCredito", new { id = s.Id })">Eliminar</button>
                </td>
            </tr>
        }
    }
    </tbody>
</table>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <link href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

    <script>
        // =============================
        // DataTable
        // =============================
        const table = $('#solicitudesTable').DataTable({
            responsive: true,
            pageLength: 10,
            columnDefs: [{ orderable: false, targets: -1 },{ targets: 0, visible: false }], // ID oculto,
            language: {
                url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
            }
        });

        const createPartialUrl = '@Url.Action("CreatePartial", "SolicitudCredito")';
        const createAjaxUrl = '@Url.Action("CreateAjax", "SolicitudCredito")';

        // =============================
        // CREAR SOLICITUD
        // =============================
        document.getElementById('btnCrear')?.addEventListener('click', async () => {
            try {
                // Loader inicial
                Swal.fire({
                    title: 'Cargando...',
                    text: 'Preparando formulario',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });

                const r = await fetch(createPartialUrl);
                const html = await r.text();

                Swal.close();

                const { value: formData } = await Swal.fire({
                    title: 'Crear solicitud',
                    html: html,
                    showCancelButton: true,
                    confirmButtonText: 'Guardar',
                    cancelButtonText: 'Cancelar',
                    focusConfirm: false,
                    preConfirm: () => {
                        const form = document.getElementById('crearSolicitudForm');
                        if (!form) {
                            Swal.showValidationMessage('Formulario inválido');
                            return false;
                        }
                        return new FormData(form);
                    }
                });

                if (!formData) return;

                Swal.fire({
                    title: 'Guardando...',
                    text: 'Procesando solicitud',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });

                const token = formData.get('__RequestVerificationToken');
                const headers = token ? { 'RequestVerificationToken': token } : {};

                const resp = await fetch(createAjaxUrl, {
                    method: 'POST',
                    headers,
                    body: formData
                });

                Swal.close();

                if (!resp.ok) {
                    const err = await resp.json().catch(() => ({ message: 'Error al crear' }));
                    Swal.fire('Error', err.message, 'error');
                    return;
                }

                const result = await resp.json();

                Swal.fire({
                    icon: 'success',
                    title: 'Solicitud creada',
                    text: result.message || 'Operación exitosa',
                    timer: 2000,
                    showConfirmButton: false
                });

                // Agregar fila a DataTable
                const d = result.data;
                        if (d) {
                           table.row.add([
            d.id,
            d.identificacion,
            d.montoSolicitado,
            d.comentarios,
            d.documento,
            `
            <button class="btn btn-sm btn-outline-secondary js-open-modal"
                data-url="/SolicitudCredito/EditPartial/${d.id}">Editar</button>
            <button class="btn btn-sm btn-danger js-open-modal ms-1"
                data-url="/SolicitudCredito/DeletePartial/${d.id}">Eliminar</button>
            `
        ]).draw(false);


        }


            } catch (e) {
                console.error(e);
                Swal.fire('Error', 'Ocurrió un error inesperado', 'error');
            }
        });

        // =============================
        // EDITAR / ELIMINAR
        // =============================
        document.addEventListener('click', async (e) => {
            const btn = e.target.closest('.js-open-modal');
            if (!btn) return;

            e.preventDefault();

            try {
                Swal.fire({
                    title: 'Cargando...',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });

                const url = btn.dataset.url;
                const resp = await fetch(url);

                if (!resp.ok) {
                    Swal.fire('Error', 'No se pudo cargar el contenido', 'error');
                    return;
                }

                const html = await resp.text();
                Swal.close();

                const modalEl = document.getElementById('app-modal');
                const modalContent = modalEl.querySelector('.modal-content');
                modalContent.innerHTML = html;

                const modal = new bootstrap.Modal(modalEl);
                modal.show();

                const form = modalContent.querySelector('.js-ajax-form');
                if (!form) return;

                form.addEventListener('submit', async (ev) => {
                    ev.preventDefault();

                    // Confirmación si es eliminar
                    if (form.action.toLowerCase().includes('delete')) {
                        const confirm = await Swal.fire({
                            title: '¿Eliminar solicitud?',
                            text: 'Esta acción no se puede deshacer',
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#d33',
                            confirmButtonText: 'Sí, eliminar',
                            cancelButtonText: 'Cancelar'
                        });
                        if (!confirm.isConfirmed) return;
                    }

                    Swal.fire({
                        title: 'Procesando...',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });

                    const fd = new FormData(form);
                    const token = fd.get('__RequestVerificationToken');
                    const headers = token ? { 'RequestVerificationToken': token } : {};

                    const r = await fetch(form.action, {
                        method: 'POST',
                        headers,
                        body: fd
                    });

                    Swal.close();

                    if (!r.ok) {
                        const err = await r.json().catch(() => ({ message: 'Error' }));
                        Swal.fire('Error', err.message, 'error');
                        return;
                    }

                    const result = await r.json();

                    // EDITAR
                   
            if (form.action.toLowerCase().includes('edit')) {
        const d = result.data;

        table.rows().every(function () {
            const row = this.data();
            if (row[0] == d.id) {
                this.data([
                    d.id,
                    d.identificacion,
                    d.montoSolicitado,
                    d.comentarios,
                    d.documento,
                    `
                    <button class="btn btn-sm btn-outline-secondary js-open-modal"
                        data-url="/SolicitudCredito/EditPartial/${d.id}">Editar</button>
                    <button class="btn btn-sm btn-danger js-open-modal ms-1"
                        data-url="/SolicitudCredito/DeletePartial/${d.id}">Eliminar</button>
                    `
                ]);
            }
        });

        table.draw(false);

            Swal.fire('Actualizado', result.message || 'Registro actualizado', 'success');
        }


                    // ELIMINAR
                           if (form.action.toLowerCase().includes('delete')) {
            const id = result.id;

            table.rows().every(function () {
                const row = this.data();
                if (row[0] == id) {
                    this.remove();
                }
            });

            table.draw(false);

            Swal.fire('Eliminado', result.message, 'success');
        }


                    modal.hide();

                }, { once: true });

            } catch (err) {
                console.error(err);
                Swal.fire('Error', 'Error inesperado', 'error');
            }
        });
    </script>
}

