@model ProyectoSGCBLL.Dtos.SolicitudCreditoDto

<form id="crearSolicitudForm"
      class="js-ajax-form"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Identificacion" class="form-label"></label>
        <input asp-for="Identificacion" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="MontoSolicitado" class="form-label"></label>
        <input asp-for="MontoSolicitado" type="number" step="0.01" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Comentarios" class="form-label"></label>
        <textarea asp-for="Comentarios" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Documento" class="form-label"></label>
        <input asp-for="Documento"  class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Estado" class="form-label"></label>
        <select asp-for="Estado" class="form-control">
            <option value="Ingresado" selected>Ingresado</option>
            <option value="Registrado">Registrado</option>
        </select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>

</form>

