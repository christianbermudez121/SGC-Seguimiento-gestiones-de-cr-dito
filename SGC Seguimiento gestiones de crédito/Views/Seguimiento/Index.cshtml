@model IEnumerable<ProyectoSGCBLL.Dtos.SolicitudCreditoDto>

@{
    ViewData["Title"] = "Seguimiento de gestiones";
}

<h2>@ViewData["Title"]</h2>

<table id="tablaSeguimiento" class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Identificación</th>
            <th>Monto</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Identificacion</td>
                <td>@s.MontoSolicitado</td>
                <td>@s.Estado</td>
                <td>
                    <button class="btn btn-primary btn-sm"
                            onclick="abrirModal(@s.Id)">
                        Cambiar estado
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- CONTENEDOR DEL MODAL -->
<div id="modalBody"></div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // DataTable
            $('#tablaSeguimiento').DataTable();

            // Función global
            window.abrirModal = function (id) {

                $.get('/Seguimiento/ChangeEstadoPartial', { id: id })
                    .done(function (html) {

                        $('#modalBody').html(html);

                        const modalEl = document.getElementById('estadoModal');
                        if (!modalEl) {
                            console.error('No existe estadoModal');
                            return;
                        }

                        const modal = new bootstrap.Modal(modalEl);
                        modal.show();
                    })
                    .fail(function () {
                        alert('Error cargando modal');
                    });
            };

        });
    </script>
}


