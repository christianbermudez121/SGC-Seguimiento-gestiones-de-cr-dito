@model IEnumerable<ProyectoSGCBLL.Dtos.SolicitudCreditoDto>

@{
    ViewData["Title"] = "Seguimiento de gestiones";
}

<h2 class="mb-3">@ViewData["Title"]</h2>

<table id="tablaSeguimiento" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Identificación</th>
            <th>Monto</th>
            <th>Estado</th>
            <th style="width:160px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Identificacion</td>
                <td>@s.MontoSolicitado</td>
                <td>@s.Estado</td>
                <td class="text-center">
                    <button type="button"
                            class="btn btn-primary btn-sm btn-cambiar-estado"
                            data-id="@s.Id">
                        Cambiar estado
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div id="modalBody"></div>

@section Scripts {
    <script>
        $(document).ready(function () {

            const table = $('#tablaSeguimiento').DataTable({
                language: { url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json" }
            });

            $('#tablaSeguimiento').on('click', '.btn-cambiar-estado', function () {

                // 1) Intentar desde data-id
                let id = parseInt($(this).attr('data-id'), 10);

                // 2) Fallback: tomarlo de la primera columna (ID) de la fila
                if (!id || id <= 0) {
                    const txt = $(this).closest('tr').find('td:first').text().trim();
                    id = parseInt(txt, 10);
                }

                alert('Click detectado. Id = ' + id);

                if (!id || id <= 0) {
                    alert('Id inválido. Revisá que la primera columna sea el ID y que el botón tenga data-id.');
                    return;
                }

                $.get('/Seguimiento/ChangeEstadoPartial', { id: id })
                    .done(function (html) {
                        $('#modalBody').html(html);

                        const modalEl = document.getElementById('estadoModal');
                        if (!modalEl) {
                            alert('No se encontró el modal con id="estadoModal"');
                            return;
                        }

                        const modal = new bootstrap.Modal(modalEl);
                        modal.show();
                    })
                    .fail(function (xhr) {
                        alert(
                            'Error cargando modal\n' +
                            'HTTP ' + xhr.status + '\n\n' +
                            (xhr.responseText || '')
                        );
                        console.error(xhr.responseText);
                    });
            });

        });
    </script>
}