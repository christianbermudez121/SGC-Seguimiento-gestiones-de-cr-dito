@model SGC_Seguimiento_gestiones_de_credito.Models.SolicitudCredito

<h2>Editar Solicitud</h2>

<form asp-action="Editar" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="ClienteId" class="form-label">ClienteId</label>
        <input asp-for="ClienteId" class="form-control" readonly />
        <span asp-validation-for="ClienteId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Monto" class="form-label">Monto</label>
        <input asp-for="Monto" class="form-control" />
        <span asp-validation-for="Monto" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Estado" class="form-label">Estado</label>
        <select asp-for="Estado" class="form-select">
            <option value="Registrado">Registrado</option>
            <option value="Devolución">Devolución</option>
            <option value="Aprobado">Aprobado</option>
            <option value="Rechazado">Rechazado</option>
        </select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Documento (PDF/Imagen):</label>
        <input type="file" name="Documento" accept=".pdf,.jpg,.jpeg,.png,.gif" class="form-control" />
        @if (!string.IsNullOrEmpty(Model.DocumentoNombre))
        {
            <p>
                Archivo actual:
                <a href="~/Documentos/@Model.DocumentoNombre" target="_blank">
                    <i class="bi bi-file-earmark-text"></i> Ver documento
                </a>
            </p>
        }
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="bi bi-save"></i> Guardar Cambios
    </button>
    <a href="/Solicitudes/Index" class="btn btn-secondary mt-2">
        <i class="bi bi-arrow-left-circle"></i> Volver al listado
    </a>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}


