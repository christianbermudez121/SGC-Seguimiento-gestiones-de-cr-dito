    @model ProyectoSGCDAL.Entities.Cliente
    @{
        var isEdit = Model?.Id > 0;
        var action = isEdit ? "EditAjax" : "CreateAjax";
        var title = isEdit ? "Editar Cliente" : "Nuevo Cliente";
    }

    <div class="modal-header">
        <h5 class="modal-title">@title</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
    </div>

    <form asp-action="@action" asp-controller="Clientes" method="post" class="js-ajax-form">
        @Html.AntiForgeryToken()
        <div class="modal-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Identificacion" class="form-label"></label>
                    <input asp-for="Identificacion" class="form-control" />
                    <span asp-validation-for="Identificacion" class="text-danger"></span>

                    <label asp-for="Nombre" class="form-label mt-2"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>

                    <label asp-for="Apellido1" class="form-label mt-2"></label>
                    <input asp-for="Apellido1" class="form-control" />
                    <span asp-validation-for="Apellido1" class="text-danger"></span>

                    <label asp-for="Apellido2" class="form-label mt-2"></label>
                    <input asp-for="Apellido2" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Correo" class="form-label"></label>
                    <input asp-for="Correo" class="form-control" />
                    <span asp-validation-for="Correo" class="text-danger"></span>

                    <label asp-for="Telefono" class="form-label mt-2"></label>
                    <input asp-for="Telefono" class="form-control" />

                    <label asp-for="FechaNacimiento" class="form-label mt-2"></label>
                    <input asp-for="FechaNacimiento" type="date" class="form-control" />

                    <div class="form-check mt-3">
                        <input asp-for="Activo" class="form-check-input" />
                        <label asp-for="Activo" class="form-check-label"></label>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button class="btn btn-success" type="submit">Guardar</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
        </div>
    </form>
