@model List<ProyectoSGCDAL.Entities.Cliente>
@{
    ViewData["Title"] = "Administración de Clientes";
    string q = ViewBag.Q as string;
    bool? activos = ViewBag.Activos as bool?;
}

<h2 class="mb-3">Administración de Clientes</h2>

@if (TempData["ok"] != null)
{
    <div class="alert alert-success">@TempData["ok"]</div>
}
@if (TempData["err"] != null)
{
    <div class="alert alert-danger">@TempData["err"]</div>
}

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label class="form-label">Buscar</label>
        <input name="q" value="@q" class="form-control" placeholder="Buscar por identificación/nombre/correo" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Estado</label>
        <select name="activos" class="form-select">
            <option value="">Todos</option>
            <option value="true" selected="@(activos == true)">Activos</option>
            <option value="false" selected="@(activos == false)">Inactivos</option>
        </select>
    </div>

    <div class="col-md-2">
        <button class="btn btn-success w-100" type="submit">Filtrar</button>
    </div>

    <div class="col-md-2 text-end">
        <a class="btn btn-primary w-100" asp-action="Create">Nuevo</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Identificación</th>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Teléfono</th>
            <th>Activo</th>
            <th style="width:240px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Identificacion</td>
                <td>@($"{c.Nombre} {c.Apellido1} {c.Apellido2}".Trim())</td>
                <td>@c.Correo</td>
                <td>@c.Telefono</td>
                <td>
                    @if (c.Activo)
                    {
                        <span class="badge bg-success">Sí</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@c.Id">Ver</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.Id">Eliminar</a>

                    <form asp-action="Toggle" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.Id" />
                        <input type="hidden" name="activo" value="@(!c.Activo)" />
                        <button class="btn btn-sm btn-outline-dark" type="submit">
                            @(c.Activo ? "Desactivar" : "Activar")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
