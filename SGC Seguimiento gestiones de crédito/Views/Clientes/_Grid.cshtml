@model IEnumerable<ProyectoSGCDAL.Entities.Cliente>

@Html.AntiForgeryToken()

<table id="tblClientes" class="table table-striped table-hover align-middle">

    <thead>
        <tr>
            <th>Identificación</th>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Teléfono</th>
            <th>Activo</th>
            <th style="width:260px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Identificacion</td>
                <td>@($"{c.Nombre} {c.Apellido1} {c.Apellido2}")</td>
                <td>@c.Correo</td>
                <td>@c.Telefono</td>
                <td>@(c.Activo ? "Sí" : "No")</td>
                <td class="text-nowrap">
                    <button class="btn btn-sm btn-outline-secondary js-open-modal"
                            data-url="@Url.Action("DetailsModal", "Clientes", new { id = c.Id })">
                        Ver
                    </button>

                    <button class="btn btn-sm btn-warning js-open-modal mx-1"
                            data-url="@Url.Action("EditModal", "Clientes", new { id = c.Id })">
                        Editar
                    </button>

                    <button class="btn btn-sm btn-danger js-open-modal"
                            data-url="@Url.Action("DeleteModal", "Clientes", new { id = c.Id })">
                        Eliminar
                    </button>

                    <button class="btn btn-sm btn-outline-warning js-post mx-1"
                            data-url="@Url.Action("DesactivarAjax", "Clientes", new { id = c.Id })">
                        Desactivar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>



