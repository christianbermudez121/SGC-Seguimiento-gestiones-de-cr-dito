@model SGC_Seguimiento_gestiones_de_crédito.Models.RegisterViewModel

<h2>Registro</h2>

<form asp-action="Register" method="post">
    <input asp-for="Email" placeholder="Email" class="form-control" />
    <input asp-for="Password" placeholder="Password" type="password" class="form-control" />
    <input asp-for="ConfirmPassword" placeholder="Repetir contraseña" type="password" class="form-control" />
    <button class="btn btn-success">Registrarse</button>
</form>

