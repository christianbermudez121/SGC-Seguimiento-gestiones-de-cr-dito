@model ProyectoSGCBLL.Dtos.SolicitudCreditoDto

@using (Html.BeginForm("EditAjax", "SolicitudCredito",
FormMethod.Post, new { id = "editarSolicitudForm", enctype = "multipart/form-data", @class = "js-ajax-form" }))
{
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label for="Identificacion" class="form-label">Identificación</label>
        <input asp-for="Identificacion" class="form-control" id="Identificacion" />
    </div>

    <div class="mb-3">
        <label for="MontoSolicitado" class="form-label">Monto solicitado</label>
        <input asp-for="MontoSolicitado" type="number" step="0.01" class="form-control" id="MontoSolicitado" name="MontoSolicitado" />
    </div>

    <div class="mb-3">
        <label for="Comentarios" class="form-label">Comentarios</label>
        <textarea asp-for="Comentarios" class="form-control" id="Comentarios" name="Comentarios"></textarea>
    </div>

    <div class="mb-3">
        <label for="Documento" class="form-label">Documento</label>
        <input asp-for="Documento" class="form-control" id="Documento" name="Documento" />
    </div>

    <div class="mb-3">
        <label asp-for="Estado" class="form-label"></label>
        <select asp-for="Estado" class="form-control">
            <option value="Registrado">Registrado</option>
            <option value="Devolucion">Devolución</option>
            <option value="Aprobado">Aprobado</option>
            <option value="Rechazado">Rechazado</option>
        </select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>

    <div class="text-end">
        <button class="btn btn-primary" type="submit">Guardar</button>
    </div>
}